{
  "version": 1,
  "sdk_version": "0.28.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://psydcacnfattarqbhwpx.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "skills4mation-hub",
      "version": "0.1.0",
      "title": "Skills4mation Hub"
    },
    "tools": [
      {
        "name": "list_dossiers",
        "title": "Lister mes dossiers de formation",
        "description": "Liste les dossiers de formation accessibles au formateur connecté (titre, entreprise, dates, statut CRM).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "statut_crm": {
              "description": "Filtre optionnel sur le statut CRM du dossier.",
              "type": "string"
            },
            "limit": {
              "description": "Nombre maximum de dossiers (défaut 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_dossier",
        "title": "Détail d'un dossier de formation",
        "description": "Renvoie le détail d'un dossier de formation (données, pièces générées et statuts) pour l'utilisateur connecté.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Identifiant du dossier."
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "update_dossier_statut_crm",
        "title": "Mettre à jour le statut CRM d'un dossier",
        "description": "Fait avancer un dossier de formation dans le pipeline CRM Skills4mation.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Identifiant du dossier."
            },
            "statut_crm": {
              "type": "string",
              "enum": [
                "brouillon",
                "demande_validation",
                "dossier_valide",
                "demande_financement",
                "accord_financement",
                "finalisation_administrative",
                "paiement",
                "paiement_formateur",
                "refuse",
                "formation_en_cours",
                "formation_realisee",
                "demande_paiement",
                "paiement_organisme"
              ],
              "description": "Nouveau statut CRM du dossier."
            }
          },
          "required": [
            "id",
            "statut_crm"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_mes_formations",
        "title": "Lister mes formations enregistrées",
        "description": "Liste les formations enregistrées par le formateur connecté, publiées ou non, avec tarifs et état de publication.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "publiee": {
              "description": "Filtre optionnel sur l'état de publication.",
              "type": "boolean"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "search_catalogue",
        "title": "Rechercher une formation au catalogue",
        "description": "Recherche dans le catalogue public Skills4mation (titre, catégorie, tarif, durée, formateur) parmi les formations publiées.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "description": "Mots-clés recherchés dans le titre.",
              "type": "string",
              "minLength": 2
            },
            "categorie": {
              "description": "Filtre optionnel sur la catégorie.",
              "type": "string"
            },
            "limit": {
              "description": "Nombre maximum de résultats (défaut 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
